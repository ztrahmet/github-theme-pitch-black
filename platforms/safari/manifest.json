{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "__VERSION__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://gist.github.com/*",
        "https://support.github.com/*",
        "https://docs.github.com/*",
        "https://education.github.com/*"
      ],
      "css": ["theme.css"],
      "run_at": "document_start"
    }
  ]
}
